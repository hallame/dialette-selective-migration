# Copier en .env (jamais versionne) et adapter.

# Base source Dialette : lecture seule, uniquement pour extraire des agregats
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=dialette
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=

# Base MariaDB du labo (jamais la base de l'application)
LAB_DB_HOST=127.0.0.1
LAB_DB_PORT=3306
LAB_DB_NAME=dialette_lab
LAB_DB_USER=root
LAB_DB_PASSWORD=

# MongoDB du labo (utilisé pour la migration vers la configuration B)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=dialette_lab
